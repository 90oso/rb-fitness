{
  "name": "rb-fitness",
  "version": "0.10.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test:metrics": "node scripts/check-metrics.cjs",
    "test:cycles": "node --no-warnings --experimental-strip-types scripts/check-cycles.mjs",
    "test:session": "node scripts/check-session.cjs",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test:metrics && npm run test:cycles && npm run test:session"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.3",
    "prettier": "^3.9.10",
    "typescript": "^5.8.3"
  }
}
